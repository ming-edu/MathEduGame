<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>小学数学闯关游戏</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "PingFang SC", "Microsoft YaHei", "Comic Sans MS", sans-serif;
    min-height: 100vh;
    background: linear-gradient(160deg, #efe4ff 0%, #dbeafe 55%, #d5f0ff 100%);
    display: flex; justify-content: center; align-items: center;
    padding: 24px; overflow-x: hidden; position: relative; color: #46365e;
  }
  .hidden { display: none !important; }
  .mutebtn { position: fixed; top: 14px; right: 14px; z-index: 95; font-size: 22px; background: #fff; border: 2px solid #e3dcf0; border-radius: 999px; width: 46px; height: 46px; cursor: pointer; box-shadow: 0 4px 10px rgba(120,90,180,0.15); }
  .mutebtn:hover { transform: scale(1.08); }
  .deco { position: fixed; font-size: 34px; opacity: 0.75; pointer-events: none; animation: float 5s ease-in-out infinite; }
  .d1 { top: 10%; left: 8%; } .d2 { top: 18%; right: 10%; animation-delay: 1.2s; }
  .d3 { bottom: 16%; left: 12%; animation-delay: 2.1s; } .d4 { bottom: 10%; right: 14%; animation-delay: 0.6s; }
  .d5 { top: 55%; left: 5%; font-size: 26px; animation-delay: 1.8s; }
  @keyframes float { 0%,100%{ transform: translateY(0) rotate(0deg);} 50%{ transform: translateY(-14px) rotate(8deg);} }
  .wrap { width: 100%; max-width: 960px; text-align: center; position: relative; z-index: 2; }
  .card { background: #fff; border-radius: 28px; box-shadow: 0 12px 30px rgba(120,90,180,0.18); padding: 26px; text-align: center; }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .back { font-size: 16px; color: #7a5bb0; font-weight: bold; background: #fff; padding: 8px 16px; border-radius: 999px; box-shadow: 0 4px 10px rgba(120,90,180,0.15); cursor: pointer; border: none; }
  .back:hover { transform: scale(1.05); }
  .scorebar { display: flex; justify-content: center; gap: 14px; margin-bottom: 8px; flex-wrap: wrap; }
  .chip { font-size: 16px; background: #f3edff; border-radius: 999px; padding: 6px 14px; color: #6a5b8c; }
  .chip b { color: #3fcb8e; font-size: 19px; }
  .chip .pink { color: #e0648a; }
  .sub { font-size: 16px; color: #9a8fb0; }
  .msg { font-size: 18px; min-height: 28px; color: #5b8def; font-weight: bold; }
  .toast { position: fixed; top: 90px; left: 50%; transform: translateX(-50%); background: #ffd166; color: #7a4b00; font-weight: bold; font-size: 20px; padding: 10px 22px; border-radius: 999px; box-shadow: 0 8px 18px rgba(0,0,0,0.18); z-index: 80; }
  .overlay { position: fixed; inset: 0; background: rgba(40,20,60,0.55); display: flex; align-items: center; justify-content: center; z-index: 70; }
  .overlay .box { position: relative; background: #fff; border-radius: 26px; padding: 34px 40px; text-align: center; max-width: 90vw; }
  .overlay .box .big { font-size: 60px; }
  .overlay .box h2 { font-size: 27px; color: #7a5bb0; margin-top: 8px; }
  .overlay .box .finalscore { font-size: 18px; color: #9a8fb0; margin-top: 8px; }
  .overlay .box .stars { font-size: 44px; letter-spacing: 6px; margin-top: 6px; }
  .overlay .box button { margin-top: 20px; font-size: 18px; padding: 10px 24px; border: none; border-radius: 16px; background: #3fcb8e; color: #fff; cursor: pointer; }
  .overlay .box button.closebtn { position: absolute; top: 6px; right: 12px; margin-top: 0; font-size: 30px; line-height: 1; background: none; color: #b3a8cf; padding: 4px 8px; border-radius: 8px; }
  .overlay .box button.closebtn:hover { color: #7a5bb0; }

  /* 大厅 */
  .head { margin-bottom: 30px; }
  .crown { font-size: 58px; display: block; animation: float 4s ease-in-out infinite; }
  h1 { font-size: 46px; margin-top: 8px; letter-spacing: 2px; background: linear-gradient(90deg,#7a3fd0,#b45bd8,#5b8def); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cards { display: flex; flex-wrap: wrap; gap: 26px; justify-content: center; }
  .hallcard { width: 260px; min-height: 240px; border-radius: 28px; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 26px 20px; text-align: center; background: #fff; border: 3px solid transparent; box-shadow: 0 10px 24px rgba(110,80,180,0.16); transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
  .hallcard:hover { transform: scale(1.07); box-shadow: 0 18px 36px rgba(110,80,180,0.28); }
