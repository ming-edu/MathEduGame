  .fighter .name { font-size: 17px; font-weight: bold; margin-top: 2px; }
  .hero .avatar { animation: idle 1.6s ease-in-out infinite; }
  .monster.hit .avatar { animation: shake 0.4s; }
  @keyframes idle { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-6px);} }
  @keyframes shake { 0%,100%{transform:translateX(0);} 25%{transform:translateX(-8px);} 50%{transform:translateX(8px);} 75%{transform:translateX(-5px);} }
  .hpwrap { margin: 4px auto 2px; width: 160px; }
  .hpbar { height: 15px; background: #f0e6f7; border-radius: 999px; overflow: hidden; border: 2px solid #e3d2f0; }
  .hpfill { height: 100%; width: 100%; background: linear-gradient(90deg,#ff8fb1,#ff6b8f); border-radius: 999px; transition: width 0.3s ease; }
  .herofill { height: 100%; width: 100%; background: linear-gradient(90deg,#7de0b0,#3fcb8e); border-radius: 999px; transition: width 0.3s ease; }
  .hptext { font-size: 13px; color: #a07ea0; margin-top: 2px; }
  .timer { width: 280px; margin: 8px auto 6px; }
  .timerbar { height: 14px; background: #f0e6f7; border-radius: 999px; overflow: hidden; border: 2px solid #e3d2f0; }
  .timerfill { height: 100%; width: 100%; background: linear-gradient(90deg,#ffd166,#ffb03a); border-radius: 999px; transition: width 1s linear; }
  .timertext { font-size: 16px; color: #e0903a; font-weight: bold; margin-top: 2px; }
  .hint { font-size: 20px; font-weight: bold; color: #e0648a; margin: 10px 0; min-height: 30px; }
  .probs { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .prob { flex: 1; min-width: 140px; padding: 16px 10px; border-radius: 18px; cursor: pointer; background: #faf7ff; border: 3px solid #d9cdf0; font-size: 23px; font-weight: bold; color: #46365e; transition: transform 0.15s ease, border-color 0.15s ease; }
  .prob:hover { transform: scale(1.05); border-color: #a78ae0; }
  .prob:active { transform: scale(0.97); }

  /* 数字迷宫 */
  .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; width: 310px; margin: 18px auto; }
  .cell { aspect-ratio: 1/1; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 25px; background: #f0ecf8; border: 2px solid #e3dcf0; }
  .cell.path { background: #eaf7ef; border-color: #bde5cf; }
  .cell.path.visited { background: #d2f0df; }
  .cell.wall { background: #5a4a75; border-color: #4c3e64; }
  .cell.shake { animation: shake 0.4s; }
  .dirbox { display: flex; gap: 10px; justify-content: center; margin: 8px 0; }
  .dirbtn { min-width: 58px; padding: 9px; border-radius: 14px; font-size: 18px; font-weight: bold; background: #faf7ff; border: 3px solid #c9b8e8; color: #46365e; cursor: pointer; }
  .dirbtn:hover:not(:disabled) { border-color: #a78ae0; transform: scale(1.06); }
  .dirbtn:disabled { opacity: 0.28; cursor: not-allowed; }
  .gate { font-size: 17px; font-weight: bold; color: #6a5b8c; margin-top: 4px; }
  .expr { font-size: 28px; font-weight: bold; color: #46365e; margin: 8px 0; }
  .choices { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .choice { min-width: 62px; padding: 11px; border-radius: 16px; cursor: pointer; font-size: 23px; font-weight: bold; background: #faf7ff; border: 3px solid #c9b8e8; color: #46365e; transition: transform 0.15s, border-color 0.15s; }
  .choice:hover { transform: scale(1.08); border-color: #a78ae0; }

  /* 图形魔法师 */
  .stage { display: flex; gap: 24px; justify-content: center; align-items: center; flex-wrap: wrap; margin: 20px 0; min-height: 190px; }
  .tray { display: flex; flex-direction: column; gap: 12px; align-items: center; }
  .board { position: relative; background: #f4f8ff; border: 3px dashed #b9c7ea; border-radius: 12px; }
  .piece { border-radius: 10px; cursor: grab; box-shadow: 0 5px 12px rgba(80,60,120,0.25); touch-action: none; user-select: none; }
  .piece.square { width: 120px; height: 120px; background: linear-gradient(135deg,#ffb36b,#ff8f5e); }
  .piece.rect { width: 60px; height: 120px; background: linear-gradient(135deg,#6fc3ff,#4f9df0); }
  .piece.small { width: 60px; height: 60px; background: linear-gradient(135deg,#ffd36b,#ffb84f); }
  .piece.wide { width: 120px; height: 60px; background: linear-gradient(135deg,#7de0b0,#3fcb8e); }
  .piece.tile { width: 60px; height: 60px; background: linear-gradient(135deg,#c58bff,#8b5cf6); }
  .board .silhouette { position: absolute; inset: 0; background: #d9e5ff; pointer-events: none; }
  .anchor { position: absolute; }
  .piece.dragging { cursor: grabbing; opacity: 0.92; }
</style>
</head>
<body>
  <span class="deco d1">⭐</span><span class="deco d2">✨</span><span class="deco d3">🪄</span><span class="deco d4">🎈</span><span class="deco d5">🔮</span>

