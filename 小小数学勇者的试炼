for(var k=0;k<closes.length;k++){ closes[k].addEventListener("click", function(){ this.closest(".overlay").classList.add("hidden"); }); }
document.getElementById("muteBtn").addEventListener("click", toggleMusic);
var hcards=document.querySelectorAll(".hallcard");
for(var i=0;i<hcards.length;i++){
  hcards[i].addEventListener("click", function(){ showScreen(this.getAttribute("data-screen")); });
}
var backs=document.querySelectorAll(".back");
for(var j=0;j<backs.length;j++){
  backs[j].addEventListener("click", function(){ showScreen("hall"); });
}
showScreen("hall");
