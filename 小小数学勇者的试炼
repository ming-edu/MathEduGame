  .hallcard .desc { font-size: 16px; color: #9287ad; margin-top: 10px; }
  .hallcard .go { margin-top: 18px; font-size: 15px; color: #fff; border-radius: 999px; padding: 7px 18px; font-weight: bold; }
  .hallcard.c1 { border-color: #ffd3df; } .hallcard.c1:hover { border-color: #ff8fb1; } .hallcard.c1 .go { background: #ff8fb1; }
  .hallcard.c2 { border-color: #c5e8ff; } .hallcard.c2:hover { border-color: #5b9df0; } .hallcard.c2 .go { background: #5b9df0; }
  .hallcard.c3 { border-color: #c9f2df; } .hallcard.c3:hover { border-color: #3fcb8e; } .hallcard.c3 .go { background: #3fcb8e; }
  .foot { margin-top: 34px; font-size: 15px; color: #a89cc5; }

  /* 勇者打怪 */
  .arena { display: flex; justify-content: space-around; align-items: flex-end; margin: 16px 0 4px; flex-wrap: wrap; gap: 10px; }
  .fighter { text-align: center; min-width: 150px; }
